# Зависимости
node_modules/

# Переменные окружения
.env

# Куки и сессии
*.json
!package.json
!**/package.json
!package-lock.json
!**/package-lock.json

# Результаты парсинга (папки — разные парсеры называют их по-разному)
Results/
**/Results/
Parser_*/Results/
*/results/
Result/
**/Result/
*/result/
screenshots/
**/screenshots/

# Результаты парсинга (отдельные файлы — не все парсеры кладут вывод в папку)
result.csv
**/result.csv
results.csv
**/results.csv
results_*.csv
**/results_*.csv
errors_*.csv
**/errors_*.csv
search_urls_*.csv
**/search_urls_*.csv
meta_data*.csv
**/meta_data*.csv
serp_features.csv
**/serp_features.csv
unisender_*.csv
**/unisender_*.csv
**/contacts.csv
incomplete_queries*.txt
**/incomplete_queries*.txt

# Отладочные дампы (HTML/скриншоты для диагностики парсеров)
debug/
**/debug/

# Логи
*.log
npm-debug.log*

# OS файлы
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Временные файлы
*.tmp
temp/

*/requests.txt

# Сохранённые вручную HTML для tf_analysis
tf_analysis/input/*
!tf_analysis/input/.gitkeep

# Бинарник Mystem (скачивается вручную, см. tf_analysis/README.md)
tf_analysis/bin/